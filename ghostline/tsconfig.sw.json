{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/sw",
    "types": []
  },
  "include": ["src/sw.ts"]
}
