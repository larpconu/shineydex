{
  "name": "ghostline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GHOSTLINE: real-life hide and seek. React + Vite + TypeScript PWA on Firebase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ghostline \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "node scripts/e2e.mjs",
    "brand": "node scripts/brand.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.34.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.56.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
